#!/bin/sh

case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null || true
        ;;
    bound|renew)
        ip addr flush dev "$interface" 2>/dev/null || true
        ip addr add "$ip/$subnet" dev "$interface" 2>/dev/null || true

        if [ -n "$router" ]; then
            ip route del default 2>/dev/null || true
            ip route add default via "$router" dev "$interface" 2>/dev/null || true
        fi
        ;;
esac

exit 0
