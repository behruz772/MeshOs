#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo "[MeshOS] Initializing persistent storage..."

mkdir -p /var/lib/meshos/transfer

if [ -b /dev/vda ]; then
    if mount -t ext4 /dev/vda /var/lib/meshos 2>/tmp/meshos-storage-error.log; then
        echo "[MeshOS] Persistent storage mounted: /dev/vda"
    else
        echo "[MeshOS] Persistent storage unavailable; using volatile storage."
        cat /tmp/meshos-storage-error.log 2>/dev/null || true
    fi
else
    echo "[MeshOS] Persistent disk not available; using volatile storage."
fi

echo
echo "================================"
echo "        MeshOS"
echo "================================"
echo "Kernel: $(uname -r)"
echo "Userspace: MeshOS"
echo

hostname meshos

echo "[MeshOS] Initializing network..."

ip link set lo up 2>/dev/null || true

if ip link show eth0 >/dev/null 2>&1; then
    ip link set eth0 up 2>/dev/null || true

    echo "[MeshOS] Requesting DHCP lease..."

    udhcpc -i eth0 -q -n \
        -s /bin/udhcpc.script \
        >/tmp/udhcpc.log 2>&1 || true
else
    echo "[MeshOS] No eth0 interface available."
fi

if [ -x /bin/meshos-daemon ]; then
    echo "[MeshOS] Starting daemon..."
    /bin/meshos-daemon &
fi

echo "[MeshOS] System ready."

while true; do
    sleep 60
done
