#!/bin/sh

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run

# The stable distribution kernel keeps the live-media filesystem and AHCI
# drivers as modules.  They are bundled in this initramfs so load them before
# looking for the CD-ROM and mounting the writable root.
for module in libahci ahci isofs overlay ttm drm_ttm_helper vmwgfx; do
    /bin/busybox insmod "/lib/modules/${module}.ko" || {
        echo "[MeshOS] ERROR: unable to load ${module}"
        exec /bin/sh
    }
done

mkdir -p /mnt/iso /mnt/rootfs /mnt/overlay /newroot

echo "[MeshOS] Waiting for boot media..."
i=0
while [ "$i" -lt 30 ]; do
    [ -b /dev/sr0 ] && break
    i=$((i + 1))
    sleep 1
done

if [ ! -b /dev/sr0 ]; then
    echo "[MeshOS] ERROR: /dev/sr0 not found"
    exec /bin/sh
fi

mount -t iso9660 -o ro /dev/sr0 /mnt/iso || exec /bin/sh

if [ ! -f /mnt/iso/live/meshos-desktop.squashfs ]; then
    echo "[MeshOS] ERROR: Desktop SquashFS not found"
    exec /bin/sh
fi

echo "[MeshOS] Mounting Desktop SquashFS..."
mount -t squashfs -o ro /mnt/iso/live/meshos-desktop.squashfs /mnt/rootfs || exec /bin/sh

echo "[MeshOS] Creating writable OverlayFS..."
mount -t tmpfs tmpfs /mnt/overlay
# The tmpfs mount above replaces the directory created during early setup,
# so create OverlayFS's required sibling directories after mounting it.
mkdir -p /mnt/overlay/upper /mnt/overlay/work
mount -t overlay overlay -o lowerdir=/mnt/rootfs,upperdir=/mnt/overlay/upper,workdir=/mnt/overlay/work /newroot || exec /bin/sh

# Make the graphical stack deterministic. SDDM otherwise auto-selects a
# display backend, which is unreliable on the minimal live image.
mkdir -p /newroot/etc/sddm.conf.d
cat > /newroot/etc/sddm.conf.d/10-meshos-x11.conf <<'EOF'
[General]
DisplayServer=x11

[Theme]
Current=debian-breeze

[X11]
ServerPath=/usr/lib/xorg/Xorg
ServerArguments=-nolisten tcp -logfile /var/log/Xorg.0.log
EOF

# Plymouth's boot daemon is not needed on the live image.  On the current
# VirtualBox/kernel combination it can stall before the display manager is
# reached, so mask it before systemd starts the graphical target.
ln -sf /dev/null /newroot/etc/systemd/system/plymouth-start.service

# The image already carries a generated linker cache.  Rebuilding it on every
# live boot scans the whole SquashFS and delays the greeter substantially.
ln -sf /dev/null /newroot/etc/systemd/system/ldconfig.service

# The VirtualBox live target uses the proven X11 stack.  Hide the Plasma
# Wayland session so SDDM cannot select a compositor that requires a DRM node
# unavailable in this minimal image.
/bin/busybox rm -f /newroot/usr/share/wayland-sessions/plasma.desktop

# Keep early graphical failures visible on the serial console used by the
# automated VM test.
mkdir -p /newroot/etc/systemd/journald.conf.d
cat > /newroot/etc/systemd/journald.conf.d/10-meshos-console.conf <<'EOF'
[Journal]
ForwardToConsole=yes
TTYPath=/dev/ttyS0
MaxLevelConsole=debug
EOF

mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
mount --move /run /newroot/run

echo "[MeshOS] Writable root ready; starting desktop."
exec /bin/busybox switch_root /newroot /sbin/init
